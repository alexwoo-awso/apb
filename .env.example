# APB configuration. Copy to .env and edit.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it: it holds the server secret, and losing
# or leaking that key invalidates every enrolled authenticator and every device
# token in one go.

# ---------------------------------------------------------------- required --

# The public HTTPS address routers will call. This is baked into every
# generated RouterOS script, so changing it means regenerating them.
APB_BASE_URL=https://apb.example.org

# The hostname Traefik routes on. Usually the host part of APB_BASE_URL.
APB_HOST=apb.example.org

# Master secret, 32 bytes of hex. Generate one with:
#
#   openssl rand -hex 32
#
# Leave this unset and the service generates one into /data/secret.key on first
# start, which is fine for a single deployment. Set it explicitly if you manage
# secrets centrally or run more than one instance against the same data.
# APB_SECRET_KEY=

# ---------------------------------------------------------------- optional --

# Listen address inside the container.
# APB_ADDR=:8080

# Where the database, the secret key and the geolocation files live.
# APB_DATA_DIR=/data
# APB_GEO_DIR=/data/geo

# Honour X-Forwarded-For. Turn this on only when a proxy you control sets it:
# with it on and no proxy, any client can forge its own address and slip past
# the rate limits.
# APB_TRUST_PROXY=true
# APB_REAL_IP_HEADER=X-Forwarded-For

# Certificate resolver name configured in your Traefik instance.
# APB_CERT_RESOLVER=leresolver

# debug | info | warn | error, and json | text.
# APB_LOG_LEVEL=info
# APB_LOG_FORMAT=json

# Fixes the first-run setup code instead of generating one into the log. Useful
# for automated provisioning; remove it once an administrator exists.
# APB_SETUP_CODE=

# Relaxes the Secure flag on the session cookie so the console works over plain
# HTTP. Local development only. Never set this on anything reachable.
# APB_DEV=false

# ------------------------------------------------------- migration only -----
#
# Compatibility endpoint for routers still running the original APB scripts.
# It is upload-only and shares one credential across every router, which is
# exactly the weakness the rework removes. Turn it on to keep an existing
# estate reporting during a cutover, then turn it off.
#
# APB_LEGACY_UPLOAD=true
# APB_LEGACY_DEVICE=legacy-routers          # a device that must already exist
# APB_LEGACY_AUTH=Basic dXNlcjpwYXNzd29yZA==  # the exact header the old scripts send
# APB_LEGACY_USER_AGENT=your-old-agent       # the old nginx User-Agent gate
