# APB connectivity test for {{.DeviceName}}.
# Run it by hand and read the log:
#   /system script run {{.Prefix}}test
#   /log print where message~"APB test"
#
# It makes one call the way the real scripts do, then probes four header shapes
# to show which ones this RouterOS build actually accepts. RouterOS sets some
# headers itself and rejects the whole fetch for others, and the failure is
# indistinguishable from a network problem, so this measures it rather than
# assuming.
:local Url "{{.BaseURL}}/api/v1"
:local Token "{{.Token}}"
:local UA "{{.UserAgent}}"
:local State "{{.ListName}}_probe"
:local Timeout {{.BlockTimeout}}
:local Auth ("Authorization: Bearer " . $Token)
:local Hdr ("Authorization: Bearer " . $Token . ",User-Agent: " . $UA)
:local Target ($Url . "/whoami?k=" . $UA)
:local Res ""

:log info ("APB test: calling " . $Target . " as {{.Mode}}, certificate check {{.VerifyCert}}")
:do { :set Res [/tool fetch url=$Target http-method=get http-header-field=$Hdr {{template "fetchopts" .}} output=user as-value] } on-error={ :log error "APB test: the real request failed. Causes in order of likelihood: the name does not resolve, there is no route to the server, or the certificate is rejected." }
:if ([:typeof $Res] = "array") do={
:log info ("APB test: status " . ($Res->"status"))
:log info ("APB test: reply " . ($Res->"data"))
:if (($Res->"status") = "finished") do={
:if ([:pick ($Res->"data") 0 2] = "1,") do={ :log info "APB test: PASS - the server answered with this device's configuration, so the address, the token and the identity are all correct" } else={ :log error "APB test: the server replied but not with a configuration line, so the token is wrong or revoked" }
}
} else={
:log error "APB test: nothing came back at all"
}

# Header shape probe. Each variant is the same request with a different header
# set; a failure here means RouterOS refused to build the request, not that the
# server said no.
:local Probe ""
:do { :set Probe [/tool fetch url=$Target http-method=get http-header-field=$Auth {{template "fetchopts" .}} output=user as-value] ; :log info ("APB test: probe A, authorization only: " . ($Probe->"status")) } on-error={ :log warning "APB test: probe A, authorization only: REFUSED by RouterOS" }
:do { :set Probe [/tool fetch url=$Target http-method=get http-header-field=($Auth . ",User-Agent: " . $UA) {{template "fetchopts" .}} output=user as-value] ; :log info ("APB test: probe B, capitalised User-Agent: " . ($Probe->"status")) } on-error={ :log warning "APB test: probe B, capitalised User-Agent: REFUSED by RouterOS" }
:do { :set Probe [/tool fetch url=$Target http-method=get http-header-field=($Auth . ",user-agent: " . $UA) {{template "fetchopts" .}} output=user as-value] ; :log info ("APB test: probe C, lowercase user-agent: " . ($Probe->"status")) } on-error={ :log warning "APB test: probe C, lowercase user-agent: REFUSED by RouterOS" }
:do { :set Probe [/tool fetch url=$Target http-method=get http-header-field=($Auth . ",X-Apb-Agent: " . $UA) {{template "fetchopts" .}} output=user as-value] ; :log info ("APB test: probe D, custom X- header: " . ($Probe->"status")) } on-error={ :log warning "APB test: probe D, custom X- header: REFUSED by RouterOS" }
:log info "APB test: done with headers. The identity travels in the URL, so a REFUSED probe costs nothing; it only records what this build tolerates."

# Address-list write probe. Adding an entry that carries a timeout is the whole
# basis of this design: a timeout is what keeps the entry in RAM instead of on
# the router's flash. If that is refused, nothing else matters. These vary one
# thing at a time - the address, the size of the timeout, and whether it is
# written literally or passed through a variable - so the refusal can be
# attributed rather than guessed at.
:local Timeout {{.BlockTimeout}}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=1d ; :log info "APB test: write J, ordinary address, 1d: OK" } on-error={ :log error "APB test: write J, ordinary address, 1d: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address={{.StateAddress}} timeout=1d ; :log info "APB test: write K, marker address {{.StateAddress}}, 1d: OK" } on-error={ :log error "APB test: write K, marker address {{.StateAddress}}, 1d: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=4w ; :log info "APB test: write L, 4w: OK" } on-error={ :log error "APB test: write L, 4w: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=6w ; :log info "APB test: write M1, 6w: OK" } on-error={ :log error "APB test: write M1, 6w: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=7w ; :log info "APB test: write M2, 7w: OK" } on-error={ :log error "APB test: write M2, 7w: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=8w ; :log info "APB test: write M3, 8w: OK" } on-error={ :log error "APB test: write M3, 8w: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=52w ; :log info "APB test: write M, 52w: OK" } on-error={ :log error "APB test: write M, 52w: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=520w ; :log info "APB test: write N, 520w written literally: OK" } on-error={ :log error "APB test: write N, 520w written literally: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout=$Timeout ; :log info "APB test: write O, the configured timeout through a variable: OK" } on-error={ :log error "APB test: write O, the configured timeout through a variable: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:do { /ip firewall address-list add list=$State address=1.2.3.4 timeout={{.BlockTimeout}} comment="probe" ; :log info "APB test: write P, exactly what the real scripts do: OK" } on-error={ :log error "APB test: write P, exactly what the real scripts do: REFUSED" }
:do { /ip firewall address-list remove [find list=$State] } on-error={}
:log info "APB test: finished. The largest timeout that says OK is the one to set as the entry timeout on the device page. Every probe carries a timeout, so none of this reached the router's flash."
