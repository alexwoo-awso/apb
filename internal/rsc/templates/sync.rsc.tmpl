# APB incremental sync for {{.DeviceName}}.
# Applies the changes the server has queued since the cursor held in RAM.
# Entries are added with a timeout so RouterOS keeps them in memory and never
# writes them to flash.
:local Url "{{.BaseURL}}/api/v1"
:local Token "{{.Token}}"
:local List "{{.ListName}}"
:local State "{{.ListName}}_state"
:local UA "{{.UserAgent}}"
:local Timeout {{.BlockTimeout}}
:local MaxLoops {{.MaxLoops}}
:global apbCursor
:global apbLock
:local Hdr ("Authorization: Bearer " . $Token . ",User-Agent: " . $UA)
:local Now [/system resource get uptime]
:local Run true
:if ([:typeof $apbLock] = "time") do={ :if (($Now - $apbLock) < 3m) do={ :set Run false } }
:if ($Run) do={
:set apbLock $Now
:do {
{{template "loadcursor" .}}
:if ([:typeof $apbCursor] != "num") do={
:log info "APB: no cursor held on this router, rebuilding the list"
/system script run {{.Prefix}}bootstrap
} else={
:local More true
:local Loops 0
:do {
:set More false
:set Loops ($Loops + 1)
:local Held [:len [/ip firewall address-list find list=$List]]
:local Res ""
:do { :set Res [/tool fetch url=($Url . "/sync?k=" . $UA . "&c=" . $apbCursor . "&n=" . $Held) http-method=get http-header-field=$Hdr {{template "fetchopts" .}} output=user as-value] } on-error={ :log warning ("APB: sync could not reach " . $Url . " - run apb-test for detail") }
:if ([:typeof $Res] = "array") do={
:if (($Res->"status") = "finished") do={
:local Next -1
:local Resync false
:local Added 0
:local Recv 0
:local Removed 0
:foreach Tok in=[:toarray ($Res->"data")] do={
:if ([:len $Tok] > 1) do={
:local K [:pick $Tok 0 1]
:local V [:pick $Tok 1 [:len $Tok]]
:if ($K = "+") do={ :set Recv ($Recv + 1) ; {{template "add" .}} }
:if ($K = "-") do={ {{template "del" .}} }
:if ($K = "c") do={ :set Next [:tonum $V] }
:if ($K = "m") do={ :set More true }
:if ($K = "r") do={ :set Resync true }
}
}
:if ($Resync) do={
:log info "APB: cursor too old, falling back to a full rebuild"
:set More false
/system script run {{.Prefix}}bootstrap
} else={
:if ($Next >= 0) do={ :if ($Next != $apbCursor) do={ :set apbCursor $Next ; {{template "savecursor" .}} } }
:if (($Recv > 0) && ($Added = 0)) do={ :log error ("APB: the server sent " . $Recv . " addresses and this router stored none of them. It is refusing timeout={{.BlockTimeout}} on an address-list entry. Lower the entry timeout on the device page, regenerate the bundle and reinstall it.") }
:if (($Added + $Removed) > 0) do={ :log info ("APB: applied +" . $Added . " -" . $Removed . ", cursor " . $apbCursor) }
}
}
}
} while=($More && ($Loops < $MaxLoops))
}
} on-error={ :log error "APB: sync script aborted" }
:set apbLock
}
